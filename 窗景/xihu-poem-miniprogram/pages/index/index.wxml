<!-- 西湖窗景诗词小程序 -->
<view class="container">
  <!-- 背景层 -->
  <view class="bg-wrap">
    <image class="bg-img {{bgLoaded ? 'loaded' : ''}}" src="{{bgUrl}}" mode="aspectFill" bindload="onBgLoad"/>
    <view class="bg-grad"></view>
    <!-- 雨滴画布 -->
    <canvas wx:if="{{weather === 'rain'}}" type="2d" id="rainCanvas" class="rain-canvas"></canvas>
    <!-- 雾层 -->
    <view wx:if="{{weather === 'fog'}}" class="fog-layer"></view>
    <!-- 雪花 -->
    <view wx:if="{{weather === 'snow'}}" class="snow-container">
      <view wx:for="{{snowflakes}}" wx:key="index" class="snowflake" style="{{item.style}}">❄</view>
    </view>
  </view>

  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <view class="clock-wrap">
      <text class="clock-time">{{clockTime}}</text>
      <text class="clock-date">{{clockDate}}</text>
    </view>
    <view class="weather-info">
      <text class="weather-icon">{{weatherIcon}}</text>
      <view class="weather-text">
        <text class="weather-desc">{{weatherDesc}}</text>
        <text class="weather-temp" wx:if="{{temp}}">{{temp}}℃  杭州西湖区</text>
        <text class="weather-temp" wx:else>杭州西湖区</text>
      </view>
    </view>
    <!-- 音频按钮 -->
    <view class="audio-btn {{isPlaying ? 'playing' : ''}}" bindtap="toggleAudio">
      <text>{{isPlaying ? '🔊' : '🌊'}}</text>
    </view>
  </view>

  <!-- 诗词区域（竖排，一句一列） -->
  <view class="poem-scroll {{poemVisible ? 'visible' : ''}}">
    <view class="poem-container">
      <!-- 诗句列 -->
      <view wx:for="{{poemLines}}" wx:key="index" class="poem-line">{{item}}</view>
      <!-- 署名列 -->
      <view class="poem-sig">{{poemSig}}</view>
    </view>
  </view>

  <!-- 上下文标签 -->
  <view class="poem-context-tag {{poemVisible ? 'visible' : ''}}">{{contextTag}}</view>

  <!-- 情感标签 -->
  <view class="emotion-tag {{poemVisible ? 'visible' : ''}}" wx:if="{{poemEmotion}}">
    <text class="emotion-name">{{poemEmotion}}</text>
    <text class="emotion-dot">·</text>
    <text class="emotion-desc">{{poemEmotionDesc}}</text>
  </view>

  <!-- 意境元素 -->
  <view class="elements-tag {{poemVisible ? 'visible' : ''}}" wx:if="{{poemElements.length > 0}}">
    <text wx:for="{{poemElements}}" wx:key="*this" class="element-item">{{item}}</text>
  </view>

  <!-- 加载提示 -->
  <view class="loading-tip" wx:if="{{loading}}">{{loadingText}}</view>

  <!-- 图片版权 -->
  <view class="img-credit">{{imgCredit}}</view>

  <!-- 模式切换按钮 -->
  <view class="mode-bar">
    <view class="mode-btn {{mode === 'now' ? 'active' : ''}}" bindtap="switchMode" data-mode="now">此刻·西湖</view>
    <view class="mode-btn {{mode === 'my' ? 'active' : ''}}" bindtap="switchMode" data-mode="my">我的·西湖</view>
  </view>

  <!-- 我的·西湖 控制面板 -->
  <view class="my-panel {{mode === 'my' ? 'open' : ''}}">
    <view class="panel-row">
      <text class="panel-label">季节</text>
      <view class="btn-group">
        <view wx:for="{{seasons}}" wx:key="value" 
              class="seg-btn {{myState.season === item.value ? 'active' : ''}}"
              bindtap="selectSeason" data-value="{{item.value}}">{{item.label}}</view>
      </view>
      <text class="panel-label" style="margin-left: 30rpx;">时段</text>
      <view class="btn-group">
        <view wx:for="{{periods}}" wx:key="value"
              class="seg-btn {{myState.period === item.value ? 'active' : ''}}"
              bindtap="selectPeriod" data-value="{{item.value}}">{{item.label}}</view>
      </view>
    </view>
    <view class="panel-row">
      <text class="panel-label">天气</text>
      <view class="btn-group">
        <view wx:for="{{weathers}}" wx:key="value"
              class="seg-btn {{myState.weather === item.value ? 'active' : ''}}"
              bindtap="selectWeather" data-value="{{item.value}}">{{item.label}}</view>
      </view>
      <view class="random-btn" bindtap="randomSelect">🎲 随机</view>
    </view>
  </view>

  <!-- 背景音频 -->
  <audio id="bgAudio" src="{{audioSrc}}" loop></audio>
</view>
