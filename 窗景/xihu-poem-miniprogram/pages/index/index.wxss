/* 页面容器 */
.container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #060e18;
}

/* ═══ 背景层 ═══ */
.bg-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a1628;
}

.bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 1.2s ease;
}

.bg-img.loaded {
  opacity: 1;
}

.bg-grad {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,8,18,.25) 0%, rgba(0,8,18,.02) 30%, rgba(0,8,18,.02) 70%, rgba(0,8,18,.5) 100%);
}

/* 雨滴画布 */
.rain-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 1;
}

/* 雾层 */
.fog-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  pointer-events: none;
  background: rgba(195,208,218,.26);
  animation: fogP 9s ease-in-out infinite;
}

/* 雪花 */
.snow-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  pointer-events: none;
}

.snowflake {
  position: fixed;
  top: -24rpx;
  color: #d6eaf8;
  pointer-events: none;
  animation: snowF linear infinite;
}

/* ═══ 顶部状态栏 ═══ */
.status-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(20rpx + env(safe-area-inset-top)) 32rpx 20rpx;
  background: linear-gradient(180deg, rgba(0,8,18,.45), transparent);
}

.clock-wrap {
  color: rgba(255,255,255,.88);
  text-shadow: 0 2rpx 16rpx rgba(0,0,0,.55);
}

.clock-time {
  font-size: 48rpx;
  font-weight: 300;
  letter-spacing: .04em;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.clock-date {
  font-size: 22rpx;
  opacity: .72;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  margin-top: 4rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: rgba(255,255,255,.82);
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,.5);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.weather-icon {
  font-size: 44rpx;
}

.weather-text {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.weather-desc {
  font-size: 26rpx;
  font-weight: 500;
}

.weather-temp {
  font-size: 20rpx;
  opacity: .7;
  margin-top: 2rpx;
}

.audio-btn {
  background: rgba(0,0,0,.35);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,.2);
  border-radius: 50%;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.85);
  font-size: 32rpx;
  transition: background .3s, transform .2s;
}

.audio-btn.playing {
  animation: pulse 2s infinite;
}

/* ═══ 诗词区域（竖排，一句一列） ═══ */
.poem-scroll {
  position: fixed;
  top: 50%;
  right: 48rpx;
  transform: translateY(-50%);
  z-index: 10;
  opacity: 0;
  transition: opacity .7s ease;
  pointer-events: none;
  max-height: 80vh;
}

.poem-scroll.visible {
  opacity: 1;
}

.poem-container {
  display: flex;
  flex-direction: row-reverse;
  gap: 24rpx;
  align-items: flex-start;
}

.poem-line {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  font-family: "KaiTi", "楷体", "STKaiti", "FangSong", "仿宋", serif;
  font-size: 42rpx;
  line-height: 1.6;
  letter-spacing: .15em;
  color: rgba(255,252,235,.95);
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.6), 0 0 40rpx rgba(0,0,0,.3);
  white-space: nowrap;
}

.poem-sig {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  font-family: "KaiTi", "楷体", "STKaiti", serif;
  font-size: 24rpx;
  color: rgba(215,190,110,.78);
  letter-spacing: .12em;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5);
  margin-right: 16rpx;
  padding-top: 40rpx;
}

.poem-context-tag {
  position: fixed;
  bottom: 180rpx;
  right: 48rpx;
  z-index: 12;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 20rpx;
  color: rgba(255,255,255,.32);
  letter-spacing: .08em;
  opacity: 0;
  transition: opacity .7s ease;
  pointer-events: none;
}

.poem-context-tag.visible {
  opacity: 1;
}

/* ═══ 情感标签 ═══ */
.emotion-tag {
  position: fixed;
  bottom: 220rpx;
  right: 48rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 12rpx;
  opacity: 0;
  transition: opacity .7s ease;
  pointer-events: none;
}

.emotion-tag.visible {
  opacity: 1;
}

.emotion-name {
  font-family: "KaiTi", "楷体", "STKaiti", serif;
  font-size: 28rpx;
  color: rgba(215,190,110,.9);
  letter-spacing: .1em;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.4);
}

.emotion-dot {
  font-size: 20rpx;
  color: rgba(215,190,110,.5);
}

.emotion-desc {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 20rpx;
  color: rgba(255,255,255,.45);
  letter-spacing: .06em;
}

/* ═══ 意境元素 ═══ */
.elements-tag {
  position: fixed;
  bottom: 260rpx;
  right: 48rpx;
  z-index: 12;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  max-width: 300rpx;
  opacity: 0;
  transition: opacity .7s ease;
  pointer-events: none;
}

.elements-tag.visible {
  opacity: 1;
}

.element-item {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 18rpx;
  padding: 6rpx 16rpx;
  background: rgba(255,255,255,.08);
  border: 1rpx solid rgba(255,255,255,.15);
  border-radius: 24rpx;
  color: rgba(255,255,255,.55);
  letter-spacing: .05em;
}

/* ═══ 底部信息 ═══ */
.loading-tip {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  color: rgba(255,255,255,.38);
  letter-spacing: .1em;
  transition: opacity .8s;
}

.img-credit {
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 20;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 18rpx;
  color: rgba(255,255,255,.22);
  letter-spacing: .05em;
}

/* ═══ 模式按钮 ═══ */
.mode-bar {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  right: 28rpx;
  z-index: 30;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.mode-btn {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255,255,255,.2);
  background: rgba(0,0,0,.32);
  backdrop-filter: blur(12px);
  color: rgba(255,255,255,.65);
  transition: all .35s;
  letter-spacing: .06em;
}

.mode-btn.active {
  background: rgba(215,175,60,.25);
  border-color: rgba(215,175,60,.7);
  color: rgba(255,230,120,.98);
  box-shadow: 0 0 40rpx rgba(215,175,60,.15);
}

/* ═══ 我的·西湖 控制面板 ═══ */
.my-panel {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(24rpx);
  z-index: 30;
  width: 92vw;
  max-width: 720rpx;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(22rpx);
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 32rpx;
  padding: 32rpx 40rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity .4s, transform .4s;
}

.my-panel.open {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.panel-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.panel-row:first-child {
  margin-top: 0;
}

.panel-label {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  color: rgba(200,200,200,.65);
  white-space: nowrap;
  min-width: 2.5em;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.seg-btn {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.07);
  color: rgba(255,255,255,.7);
  transition: background .2s, border-color .2s, color .2s;
  letter-spacing: .06em;
}

.seg-btn.active {
  background: rgba(220,180,80,.25);
  border-color: rgba(220,180,80,.7);
  color: rgba(255,230,120,.98);
}

.random-btn {
  margin-left: auto;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  padding: 14rpx 36rpx;
  background: rgba(220,160,60,.2);
  border: 1rpx solid rgba(220,180,80,.45);
  color: rgba(255,230,120,.92);
  border-radius: 12rpx;
  transition: background .2s, transform .15s;
  letter-spacing: .08em;
}
