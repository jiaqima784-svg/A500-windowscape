/* 全局样式 */
page {
  width: 100%;
  height: 100%;
  background: #0a1628;
  font-family: "KaiTi", "楷体", "STKaiti", "STSong", "SimSun", serif;
}

/* 通用工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,.2); }
  50% { box-shadow: 0 0 0 16rpx rgba(255,255,255,0); }
}

@keyframes snowF {
  0% { transform: translateY(0) rotate(0); opacity: .75; }
  100% { transform: translateY(100vh) rotate(400deg); opacity: 0; }
}

@keyframes fogP {
  0%, 100% { opacity: .9; }
  50% { opacity: .5; }
}
